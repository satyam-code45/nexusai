# ─────────────────────────────────────────────────────────────────────────────
# NexusAI — Environment Variables
# Copy this file to .env.local and fill in every value before running the app.
# Never commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────────────────────────────────────


# ── App URLs ──────────────────────────────────────────────────────────────────
# Base URL of the Next.js app (no trailing slash). Required — every client-side
# API call (src/lib/helper/makeHttpReq.ts and others) is built by prefixing this
# value, so if it's unset in production every fetch resolves to "undefined/api/...".
# It's a NEXT_PUBLIC_* var, so it's baked in at build time: changing it requires
# a fresh deploy, not just an env var update.
# In production replace with your actual domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Must match NEXT_PUBLIC_APP_URL exactly — used by NextAuth for OAuth callbacks.
NEXTAUTH_URL=http://localhost:3000


# ── NextAuth ──────────────────────────────────────────────────────────────────
# Random 32-byte hex string.  Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=your_nextauth_secret_here


# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must be: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# Exposed to the browser — used by AddSourceModal to open the Google Drive picker.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google API developer key (not OAuth) — needed for the Drive picker widget.
# Create at https://console.cloud.google.com/apis/credentials → API key
NEXT_PUBLIC_DEVELOPPER_KEY=your_google_api_developer_key


# ── MongoDB ───────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (or a local mongod URI for dev).
# The database name is part of the URI path (e.g. /nexusai-db).
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/nexusai-db


# ── Pinecone (vector store) ───────────────────────────────────────────────────
# Create an index at https://app.pinecone.io
# Dimension must match the OpenAI embedding model output (1536 for text-embedding-3-small).
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=nexusai


# ── LLM provider ──────────────────────────────────────────────────────────────
# OpenAI — used for chat completion, embeddings (text-embedding-3-small),
# memory compression, image reading, and audio overview generation.
# Get key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key


# ── Exa (web search) ──────────────────────────────────────────────────────────
# Used by the researcher agent's webSearch tool to search the live web when
# uploaded documents don't cover the question.
# Get key at https://dashboard.exa.ai
EXA_API_KEY=your_exa_api_key


# ── Cloudinary (media & file uploads) ────────────────────────────────────────
# Create a free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# ── Real-time collaboration (Yjs / y-websocket) ───────────────────────────────
# WebSocket URL for the y-websocket server (run separately: node scripts/yws-server.mjs).
# In production point this at your deployed WebSocket server.
NEXT_PUBLIC_YWEBSOCKET_URL=ws://localhost:1234

# Optional: port override for the bundled y-websocket server script.
# YWS_PORT=1234

# HMAC secret used to sign/verify short-lived WS auth tokens. Must be set to the
# SAME value on the Next.js app and the y-websocket server. If unset, WS auth is
# skipped entirely (dev-only fallback — do not deploy to production without this).
WS_SECRET=your_random_secret_here


# ── Inngest (background job processing) ──────────────────────────────────────
# Runs docEmbedding (PDF/docx/youtube/text embedding pipeline) as a durable
# background function instead of an in-process Agenda poller — needed because
# Vercel serverless functions can't keep a long-lived poller alive. Inngest
# invokes /api/inngest via HTTP per step, so it works natively on Vercel.
# Not needed for local dev — `npx inngest-cli@latest dev` (run via `npm run dev`)
# auto-discovers the local endpoint with no keys required.
# For production: create an app at https://app.inngest.com and copy these from
# its dashboard into your Vercel project's env vars.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
